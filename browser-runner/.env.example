PORT=8788
# Must match Worker secret BROWSER_API_KEY (leave empty only for local trusted LAN)
BROWSER_API_KEY=change-me
HEADLESS=true
# Pull 모드 (터널 불필요): Worker 주소를 넣으면 러너가 Worker로 일감을 받으러 갑니다.
# Worker 쪽은 wrangler.toml [vars] BROWSER_MODE="pull" + D1 마이그레이션 0003 필요.
WORKER_URL=https://villain-rp-chatbot.e5eeeee.workers.dev
# Optional: bind host
HOST=0.0.0.0
